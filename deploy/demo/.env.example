# Copy to .env and fill values locally. Never commit deploy/demo/.env.
AIC_PORT=8080
AIC_MODEL=mistral-3.5
AIC_LOG_LEVEL=INFO
AIC_MAX_ITERATIONS=20

POSTGRES_DB=aic
POSTGRES_USER=aic
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://aic:change-this-local-password@postgres:5432/aic

QDRANT_URL=http://qdrant:6333
MEM0_COLLECTION=aic_incident_memory
MEM0_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEM0_EMBEDDING_DIMS=384
MEM0_MIN_SCORE=0.45

HOLMES_URL=http://holmesgpt:5050
HOLMES_API_KEY=change-this-local-holmes-api-key
HOLMES_IMAGE=robustadev/holmes:0.39.0
HOLMES_APPROVAL_TTL_SECONDS=900
# Keep read-only mode until the remediation MCP pod is healthy.
# HOLMES_TOOLSET_CONFIG=/etc/holmes/config/remediation-toolset.yaml
K8S_CLUSTER_NAME=k8s-poc
KUBECONFIG_PATH=./holmesgpt/kubeconfig

LITELLM_BASE_URL=https://llmpipe.vnpost.vn/v1
LITELLM_API_KEY=replace-with-local-key
